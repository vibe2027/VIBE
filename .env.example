# VIBE Environment Variables
# Copy this to .env and fill in your actual values

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
BASE_URL=https://vibegay.ca

# ─────────────────────────────────────────────────────────────
# Supabase (Get from Settings → API)
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://fhksytcoyjtcrkmhnoyw.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────
# Stripe (Get from Dashboard → Developers → API Keys)
# ─────────────────────────────────────────────────────────────

# Live Keys (Production)
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Test Keys (Development) — uncomment to use
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_test_...

# ─────────────────────────────────────────────────────────────
# Stripe Price IDs (Get from Products dashboard)
# ─────────────────────────────────────────────────────────────
STRIPE_PRICE_PREMIUM=price_1234567890
STRIPE_PRICE_FOUNDER=price_0987654321

# ─────────────────────────────────────────────────────────────
# Optional: Logging & Debug
# ─────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=info
