# ========================================
# VIBE Production Environment Configuration
# Phase 6 + Core Services
# ========================================

# === SUPABASE (Core Database) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === ELASTICSEARCH (Search & Analytics) ===
ELASTICSEARCH_URL=https://elasticsearch.yourdomain.com:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elastic-password
ELASTICSEARCH_INDEX=vibe-content

# === OPENAI (NLP Moderation) ===
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MODERATION_MODEL=text-moderation-latest

# === WEBRTC (Video & Audio) ===
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=vibe-rtc
TURN_PASSWORD=your-secure-turn-password
WEBRTC_RECORDING_BUCKET=video-recordings

# === STRIPE (Payments & Billets) ===
STRIPE_PUBLIC_KEY=pk_live_your-stripe-public
STRIPE_SECRET_KEY=sk_live_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# === SENDGRID (Email) ===
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@vibegay.ca

# === FEATURE FLAGS (Rollback Control) ===
FEATURE_FLAG_REALTIME_COLLAB=true
FEATURE_FLAG_ADVANCED_SEARCH=true
FEATURE_FLAG_RECOMMENDATIONS=true
FEATURE_FLAG_MOBILE_APP=true
FEATURE_FLAG_WEBRTC_VIDEO=true
FEATURE_FLAG_NLP_MODERATION=true

# === APPLICATION ===
NODE_ENV=production
APP_URL=https://vibegay.ca
API_PORT=3000
LOG_LEVEL=info

# === DATABASE BACKUP ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily

# === MONITORING & ANALYTICS ===
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DATADOG_API_KEY=your-datadog-api-key
